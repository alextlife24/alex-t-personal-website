# ============================================================
# Supabase
# ============================================================
# Supabase Dashboard → Project Settings → Data API / API Keys
#
# 這兩個是 public 值，會被打包進前端。
# 資料安全由 Row Level Security 保護，不是靠隱藏這個 key。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ------------------------------------------------------------
# 僅供伺服器 / 本機腳本使用（npm run seed）
#
# 這把 key 可以繞過所有 RLS，絕對不要：
#   - 加上 NEXT_PUBLIC_ 前綴
#   - 在任何 client component 中引用
#   - commit 進 git
#
# 不執行 seed 腳本的話，這一行可以留空。
# Vercel 上除非有伺服器端需求，否則不需要設定這個變數。
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
